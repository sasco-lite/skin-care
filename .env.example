# Nikhar Skincare - Environment Variables for Vercel Deployment
# Only these 3 variables are needed:

# 1. MongoDB Connection String (MongoDB Atlas or self-hosted)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nikhar_skincare?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/nikharskincare?retryWrites=true&w=majority"

# 2. Admin Portal Credentials
ADMIN_USERNAME="hunaina_admin"
ADMIN_PASSWORD="ChooseAStrongSecretPassword2026!"

# Optional local port (defaults to 3000)
PORT="3000"
